{
  "manifest_version": 3,
  "name": "Universal Web Debugger Overlay",
  "version": "1.0.0",
  "description": "High-performance hover inspector with zero interference.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Universal Web Debugger"
  }
}
